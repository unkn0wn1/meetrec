{
  "name": "meetrec",
  "version": "0.2.0",
  "description": "Desktop meeting recorder: mix mic + system audio into a local file.",
  "license": "MIT",
  "author": "Spencer Hardy",
  "homepage": "https://github.com/unkn0wn1/meetrec",
  "repository": {
    "type": "git",
    "url": "https://github.com/unkn0wn1/meetrec.git"
  },
  "bugs": {
    "url": "https://github.com/unkn0wn1/meetrec/issues"
  },
  "main": "./out/main/index.js",
  "desktopName": "meetrec.desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "npm run typecheck && electron-vite build",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "dist": "npm run fetch:ffmpeg && npm run build && electron-builder --publish never",
    "dist:linux": "npm run fetch:ffmpeg -- --platform linux && npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run fetch:ffmpeg -- --platform win && npm run build && electron-builder --win --publish never",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard:file-size": "node scripts/guard-file-size.mjs",
    "prepare": "husky || true",
    "dev:sandboxed": "electron-vite dev"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,vue,json,md,css,html,yml}": [
      "prettier --write"
    ],
    "*.{js,mjs,cjs,ts,vue}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.511.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.3.2",
    "tailwind-merge": "^3.3.1",
    "vue": "3.5.43",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.7"
  }
}
