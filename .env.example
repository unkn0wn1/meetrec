# Optional fallbacks. Prefer the Settings screen in the app.
# Each variable is read only when that provider is the active choice
# and Settings has no saved key. Never commit real keys.

# XAI_API_KEY=
# OPENAI_API_KEY=

# Calendar desktop clients. A saved Settings value wins.
# Do not commit real ids or the Google client secret.
# MEETREC_GOOGLE_CLIENT_ID=
# MEETREC_GOOGLE_CLIENT_SECRET=
# MEETREC_MICROSOFT_CLIENT_ID=
